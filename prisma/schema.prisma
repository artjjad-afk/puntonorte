generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(200)
  slug          String   @unique @db.VarChar(200)
  price         Float
  originalPrice Float?
  // Precio de compra / costo — SOLO uso interno del admin. Nunca se expone al público.
  cost          Float?
  category      String   @db.VarChar(100)
  subcategory   String?  @db.VarChar(100)
  description   String   @db.Text
  images        String   @db.LongText
  // Videos: enlaces (YouTube/Vimeo/.mp4) o archivos subidos (/uploads/...). JSON.
  videos        String?  @db.Text
  // Si true, el/los video(s) se muestran antes que las fotos en la galería
  videoFirst    Boolean  @default(false)
  sizes         String?  @db.Text
  colors        String?  @db.Text
  badge         String?  @db.VarChar(50)
  stock         Int      @default(0)   // unidades disponibles — manejado por el sistema
  inStock       Boolean  @default(true) // calculado: stock > 0 (se actualiza automáticamente)
  featured      Boolean  @default(false)
  active        Boolean  @default(true)
  showInOffers  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("products")
}

model Category {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  slug          String   @unique @db.VarChar(100)
  image         String?  @db.VarChar(500)
  imageData     String?  @db.LongText
  active        Boolean  @default(true)
  showInNav     Boolean  @default(true)
  showInHome    Boolean  @default(false)
  order         Int      @default(0)
  // Subopciones del menú (dropdown). JSON: [{ "name": "Nike", "slug": "nike" }, ...]
  subcategories String?  @db.Text
  createdAt     DateTime @default(now())

  @@map("categories")
}

model Banner {
  id          Int      @id @default(autoincrement())
  etiqueta    String?  @db.VarChar(100)
  titulo      String   @db.VarChar(200)
  subtitulo   String?  @db.VarChar(200)
  descripcion String?  @db.Text
  linkUrl     String   @db.VarChar(300)
  linkTexto   String   @db.VarChar(100)
  imagen      String?  @db.VarChar(500)
  imageData   String?  @db.LongText
  precioDesde Float?
  active      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String   @db.VarChar(200)
  customerPhone String   @db.VarChar(50)
  address       String   @db.Text
  city          String   @db.VarChar(100)
  notes         String?  @db.Text
  paymentMethod String   @db.VarChar(50)
  items         String   @db.LongText
  total         Float
  status        String   @default("pending") @db.VarChar(50)
  // Canal de la venta: 'web' (checkout) o 'store' (venta presencial registrada por el admin)
  source        String   @default("web") @db.VarChar(20)
  accessToken   String?  @db.VarChar(64)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("orders")
}
